# Ops Monitor — environment variables. Copy to .env (local dev) or load
# these into Hostinger's environment variable panel for production.
# NEVER commit a real .env file — it is already in .gitignore.

NODE_ENV=development

# MySQL connection string (Hostinger provides this once the DB is created).
# Format: mysql://user:password@host:port/database
DATABASE_URL=

# Public URL this app is served from.
APP_URL=https://ops.moraapps.com

# IANA timezone used for all UI formatting and the daily AI brief window.
APP_TIMEZONE=America/Argentina/Salta

# --- Admin account (single user, see docs/SECURITY.md) ---------------------
ADMIN_EMAIL=
# Generate with: node -e "console.log(require('./src/lib/password').hashPassword(process.argv[1]))" <your-password>
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Windows Monitor Agent auth --------------------------------------------
# Comma-separated "agentId:secret" pairs, one per machine. Today there is
# exactly one machine/agent. AGENT_ID/AGENT_SECRET below are the values the
# agent itself uses (agent/.env) — they must match one pair here.
AGENT_SECRETS=fernando-agent:CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
AGENT_ID=fernando-agent
AGENT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# --- Gemini (AI briefs / on-demand analysis) --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Cron protection ---------------------------------------------------------
# Sent as the X-Cron-Secret header (or ?secret=) by Hostinger Cron when
# calling /api/cron/*. Generate the same way as SESSION_SECRET.
CRON_SECRET=

# --- Web Push (optional — leave blank to disable notifications) ------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@moraapps.com
